# Memory Jar Backend — Production Environment Variables
# Configure these in your Render or Railway Dashboard > Environment Variables

PORT=5000
NODE_ENV=production

# The URL of your deployed frontend (Vercel domain or custom domain)
# Examples:
# https://memory-jar.vercel.app
# https://memoryjar.app
FRONTEND_URL=https://memory-jar.vercel.app
CLIENT_URL=https://memory-jar.vercel.app

# Path to persistent disk volume mount (Render mount path: /var/data, Railway mount path: /data)
DATA_DIR=/var/data

# VAPID Keys for Web Push Notifications
# IMPORTANT: Keep VAPID_PRIVATE_KEY secret! Never commit to GitHub.
VAPID_PUBLIC_KEY=BIKZISjQ8G8ovWn0tdrMYkAXlWWs-C4wDGFd8GZNknepGflYRDTw7LP0QblSQB_1gSJd8ceydDWBhH-RYIZ114k
VAPID_PRIVATE_KEY=YOUR_PRODUCTION_PRIVATE_KEY_SECURELY_SET_HERE
VAPID_SUBJECT=mailto:hello@memoryjar.app

